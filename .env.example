# Any OpenAI-compatible endpoint works. Copy to .env and fill in.

# Gemini free tier (key: https://aistudio.google.com/apikey). Check the model ID and limits in AI Studio.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-key-here
LLM_MODEL=gemini-3.5-flash-lite
# Free tier is ~10 requests/minute: space calls out so runs don't hit 429s.
LLM_MIN_INTERVAL_S=6.5

# Groq alternative:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_MIN_INTERVAL_S=2

# Optional: reasoning models may spend the token budget "thinking"; this keeps it short.
# LLM_EXTRA_BODY={"reasoning_effort": "low"}
# LLM_JSON_MODE=0   # set if your provider rejects response_format=json_object

# Optional: price per 1M tokens, only used for the cost estimate in traces (Flash-Lite paid rates)
LLM_PRICE_IN_PER_M=0.30
LLM_PRICE_OUT_PER_M=2.50

# Optional: better search results (free 1,000 credits/month at https://app.tavily.com). Without it, keyless search is used.
TAVILY_API_KEY=
